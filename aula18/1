const express = require('express');
const bcrypt = require('bcryptjs');

const app = express();
const PORT = process.env.PORT || 3000; 

app.use(express.json());


app.post('/api/v1/prova/register', async (req, res) => {
    const { email, senha } = req.body;

    // 1. Validação: Verifica se os campos foram enviados
    if (!email || !senha) {
        return res.status(400).json({ error: 'Email e senha são obrigatórios.' });
    }

    // 2. Validação: A senha deve ter no mínimo 6 caracteres
    if (senha.length < 6) {
        return res.status(400).json({ error: 'A senha deve ter no mínimo 6 caracteres.' });
    }

    try {
        // 3. Geração do HASH utilizando bcryptjs com salt 10
        const saltRounds = 10;
        const senhaHash = await bcrypt.hash(senha, saltRounds);

      // 4. Resposta simulando o salvamento no banco de dados
  
        return res.status(201).json({
            message: 'Usuário registrado com sucesso!',
            user: {
                email: email,
                senha: senhaHash
            }
        });

    } catch (error) {
        return res.status(500).json({ error: 'Erro interno ao registrar usuário.' });
    }
});

// Inicialização do servidor
app.listen(PORT, () => {
    console.log(`Servidor rodando com sucesso na porta ${PORT}`);
});
